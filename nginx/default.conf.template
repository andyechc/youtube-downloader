# Proxy inverso hacia el servicio yt-downloader.
# ${NGINX_DOMAIN} y el puerto los define docker-compose (ver .env.example).
upstream yt_app {
    server yt-downloader:8000;
}

server {
    listen 80;
    server_name ${NGINX_DOMAIN};

    # Descargas de video: conexiones largas + respuestas grandes
    client_max_body_size 32m;
    proxy_read_timeout 3600s;
    proxy_send_timeout 3600s;
    proxy_request_buffering off;
    proxy_buffering on;
    proxy_max_temp_file_size 2048m;

    location / {
        proxy_pass http://yt_app;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
